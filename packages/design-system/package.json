{
  "name": "@heogeon0/aui",
  "version": "0.1.0",
  "description": "Theme 주입과 제한된 props를 제공하는 범용 React 디자인 시스템",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heogeon0/aui.git",
    "directory": "packages/design-system"
  },
  "homepage": "https://github.com/heogeon0/aui#readme",
  "bugs": "https://github.com/heogeon0/aui/issues",
  "keywords": [
    "react",
    "design-system",
    "radix-ui",
    "theme",
    "capacitor"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist",
    "ai",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./eslint": "./dist/eslint/index.mjs",
    "./llms.txt": "./ai/llms.txt",
    "./llms-full.txt": "./ai/llms-full.txt",
    "./llms/*": "./ai/llms/*",
    "./agents.md": "./ai/agents.md",
    "./skill/*": "./ai/skill/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "dev": "node scripts/watch.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "lucide-react": "^1.63.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
